# ─── Meta: WhatsApp / Instagram / Messenger ────────────
META_APP_SECRET=
META_VERIFY_TOKEN=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ─── Payments (empty = mock) ───────────────────────────
PAYSERA_PROJECT_ID=
PAYSERA_SIGN_PASSWORD=

# ─── Fiscalization (mock | easypos | fature_al) ────────
FISCAL_PROVIDER=mock
EASYPOS_API_KEY=
