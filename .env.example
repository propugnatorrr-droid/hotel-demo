# ─── App ───────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Supabase (EU / Frankfurt project) ─────────────────
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (or legacy anon key, both work here)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=
# Transaction pooler connection string (port 6543)
DATABASE_URL=

# ─── Demo ──────────────────────────────────────────────
DEMO_PASSWORD=change-me-demo-2026

# Set to false on real client deployments
DEMO_LOGIN_ENABLED=true

# ─── AI (empty = mock) ─────────────────────────────────
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ─── Channel manager (empty = mock) ────────────────────
CHANNEX_BASE_URL=https://staging.channex.io/api/v1
